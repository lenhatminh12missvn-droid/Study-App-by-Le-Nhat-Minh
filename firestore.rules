rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private study data: only its owner can read or write it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public leaderboard cards: signed-in users can read; each user can write only their own card.
    // Note: client-side scores can be manipulated. Use Cloud Functions for a cheat-resistant league.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
